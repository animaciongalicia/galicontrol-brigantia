# ---------------------------------------------------------------------------
# GALICONTROL BRIGANTIA — variables de entorno
# Copia este archivo como `.env.local` para desarrollo y añade los mismos
# valores en Vercel (Project Settings -> Environment Variables).
# NUNCA subas `.env.local` ni las claves reales a GitHub.
# ---------------------------------------------------------------------------

# Dominio final de la web (sin barra final). Se usa en canonical, sitemap y OG.
NEXT_PUBLIC_SITE_URL=https://www.galicontrolbrigantia.com

# --- Datos de contacto (visibles en la web) --------------------------------
# Ya están puestos por defecto en src/config/site.ts. Estas variables solo
# hacen falta si algún día cambian y no se quiere tocar el código.
# NEXT_PUBLIC_PHONE=+34626588172        # teléfono, formato internacional
# NEXT_PUBLIC_WHATSAPP=34626588172      # wa.me: solo dígitos, sin el "+"
# NEXT_PUBLIC_EMAIL=galicontrol@brigantia.pro

# CIF de la sociedad. Ya está puesto por defecto en src/config/site.ts.
# NEXT_PUBLIC_TAX_ID=B22814933

# --- Redes sociales (opcional) ---------------------------------------------
# Déjalas sin definir mientras no existan los perfiles.
# NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/...
# NEXT_PUBLIC_FACEBOOK=https://www.facebook.com/...
# NEXT_PUBLIC_LINKEDIN=https://www.linkedin.com/company/...

# --- Medición de Google ----------------------------------------------------
# Los tres valores están puestos por defecto en src/config/site.ts. Estas
# variables solo hacen falta si cambian las cuentas.
#
# Verificación de Search Console: solo la cadena del atributo content, no la
# etiqueta entera. Vacío = no se imprime nada.
# NEXT_PUBLIC_GSC_VERIFICATION=6AN53enYCoLD_DuK0jOMjamqlhXlnEilHTQbI2_MQYk
#
# Tag Manager y Analytics 4. Se cargan SOLO tras aceptar las cookies.
# Deja vacío el que no quieras usar.
# OJO: GA4 va cargado directamente. Si además creas una etiqueta de GA4 dentro
# de Tag Manager, contarás cada visita dos veces.
# NEXT_PUBLIC_GTM_ID=GTM-M9DJPKNC
# NEXT_PUBLIC_GA_ID=G-V3B4SHXV3R

# --- Envío del formulario (Resend) -----------------------------------------
# Clave de API de https://resend.com (SOLO en servidor, nunca NEXT_PUBLIC_).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Buzón que recibe las solicitudes de presupuesto. Puede ser cualquiera: no
# necesita estar verificado en Resend, solo hay que leerlo.
LEADS_EMAIL=galicontrol@brigantia.pro
# Remitente. SÍ debe pertenecer a un dominio verificado en Resend. Verifica
# galicontrolbrigantia.com, que es el dominio de la web.
FROM_EMAIL=web@galicontrolbrigantia.com
