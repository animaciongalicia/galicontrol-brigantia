# ---------------------------------------------------------------------------
# GALICONTROL BRIGANTIA — variables de entorno
# Copia este archivo como `.env.local` para desarrollo y añade los mismos
# valores en Vercel (Project Settings -> Environment Variables).
# NUNCA subas `.env.local` ni las claves reales a GitHub.
# ---------------------------------------------------------------------------

# Dominio final de la web (sin barra final). Se usa en canonical, sitemap y OG.
NEXT_PUBLIC_SITE_URL=https://www.galicontrolbrigantia.com

# --- Datos de contacto (visibles en la web) --------------------------------
# Ya están puestos por defecto en src/config/site.ts. Estas variables solo
# hacen falta si algún día cambian y no se quiere tocar el código.
# NEXT_PUBLIC_PHONE=+34626588172        # teléfono, formato internacional
# NEXT_PUBLIC_WHATSAPP=34626588172      # wa.me: solo dígitos, sin el "+"
# NEXT_PUBLIC_EMAIL=info@galicontrolbrigantia.com

# CIF de la sociedad. Aparece en el aviso legal cuando se define.
# NEXT_PUBLIC_TAX_ID=B00000000

# --- Redes sociales (opcional) ---------------------------------------------
# Déjalas sin definir mientras no existan los perfiles.
# NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/...
# NEXT_PUBLIC_FACEBOOK=https://www.facebook.com/...
# NEXT_PUBLIC_LINKEDIN=https://www.linkedin.com/company/...

# --- Google Search Console -------------------------------------------------
# Solo la cadena del atributo content de la etiqueta google-site-verification,
# no la etiqueta entera. Si está vacío, no se imprime nada en el HTML.
# NEXT_PUBLIC_GSC_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Envío del formulario (Resend) -----------------------------------------
# Clave de API de https://resend.com (SOLO en servidor, nunca NEXT_PUBLIC_).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Buzón que recibe las solicitudes de presupuesto (el Gmail de Dani).
LEADS_EMAIL=dani@galicontrolbrigantia.com
# Remitente verificado en Resend (debe pertenecer a un dominio verificado).
FROM_EMAIL=web@galicontrolbrigantia.com
